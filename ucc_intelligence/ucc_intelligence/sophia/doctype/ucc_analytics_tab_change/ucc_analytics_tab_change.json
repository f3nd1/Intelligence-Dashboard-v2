{
 "doctype": "DocType",
 "name": "UCC Analytics Tab Change",
 "module": "Sophia",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "engine": "InnoDB",
 "autoname": "hash",
 "sort_field": "changed_at",
 "sort_order": "DESC",
 "description": "Audit trail for Sophia Analytics tab configuration. One record per change. These tabs feed EduTrust evidence, so who put a chart there and when is an audit question.",
 "field_order": [
  "criterion", "tab", "action", "summary",
  "changed_by", "changed_at", "before_value", "after_value"
 ],
 "fields": [
  {"fieldname": "criterion", "fieldtype": "Data", "label": "Criterion", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "tab", "fieldtype": "Data", "label": "Tab", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "action", "fieldtype": "Data", "label": "Action", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1,
   "description": "chart_added, chart_removed, chart_resized, charts_reordered, intro_edited, question_hidden, question_shown"},
  {"fieldname": "summary", "fieldtype": "Data", "label": "What changed", "in_list_view": 1, "length": 300},
  {"fieldname": "changed_by", "fieldtype": "Link", "options": "User", "label": "Changed by", "reqd": 1, "in_list_view": 1},
  {"fieldname": "changed_at", "fieldtype": "Datetime", "label": "Changed at", "reqd": 1},
  {"fieldname": "before_value", "fieldtype": "Long Text", "label": "Before"},
  {"fieldname": "after_value", "fieldtype": "Long Text", "label": "After"}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "delete": 1, "export": 1, "report": 1}
 ]
}
