{
	"doctype": "DocType",
	"name": "UCC Monitoring Finding",
	"module": "Sophia",
	"custom": 0,
	"istable": 0,
	"issingle": 0,
	"track_changes": 1,
	"engine": "InnoDB",
	"autoname": "hash",
	"fields": [
		{"fieldname": "rule", "fieldtype": "Link", "options": "UCC Monitoring Rule", "label": "Rule", "reqd": 1},
		{"fieldname": "finding_key", "fieldtype": "Data", "label": "Finding Key", "reqd": 1,
		 "description": "rule_id::doctype::record. Deduplication key -- rerunning a rule updates the existing open finding instead of creating a second one."},
		{"fieldname": "target_doctype", "fieldtype": "Data", "label": "Target DocType"},
		{"fieldname": "target_record", "fieldtype": "Data", "label": "Target Record"},
		{"fieldname": "detail", "fieldtype": "Small Text", "label": "Detail",
		 "description": "What specifically failed, stated deterministically. Never AI-generated -- CLAUDE.md §11 keeps the pass/fail decision out of the model."},
		{"fieldname": "column_break_1", "fieldtype": "Column Break"},
		{"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Open\nResolved\nSuppressed", "default": "Open"},
		{"fieldname": "severity", "fieldtype": "Select", "label": "Severity", "options": "Low\nMedium\nHigh", "default": "Medium"},
		{"fieldname": "responsible_role", "fieldtype": "Link", "options": "Role", "label": "Responsible Role"},
		{"fieldname": "first_seen_run", "fieldtype": "Link", "options": "UCC Monitoring Run", "label": "First Seen In Run"},
		{"fieldname": "last_seen_run", "fieldtype": "Link", "options": "UCC Monitoring Run", "label": "Last Seen In Run"},
		{"fieldname": "occurrence_count", "fieldtype": "Int", "label": "Times Seen", "default": "1"},
		{"fieldname": "resolved_at", "fieldtype": "Datetime", "label": "Resolved At"},
		{"fieldname": "suppression_reason", "fieldtype": "Small Text", "label": "Suppression Reason",
		 "description": "Required to suppress. A suppressed finding stays auditable rather than disappearing."},
		{"fieldname": "rule_version", "fieldtype": "Data", "label": "Rule Version"}
	],
	"permissions": [
		{"role": "System Manager", "read": 1, "write": 1, "create": 0, "delete": 0}
	]
}
